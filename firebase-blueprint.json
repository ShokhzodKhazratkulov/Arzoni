{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "A local food spot with affordable meals.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the restaurant" },
        "address": { "type": "string", "description": "Address in Tashkent or city name" },
        "dishes": { "type": "array", "items": { "type": "string" }, "description": "List of dishes served" },
        "price": { "type": "number", "description": "Average price per meal in so'm (computed)" },
        "avgPrice": { "type": "number", "description": "Average price per meal in so'm (computed)" },
        "rating": { "type": "number", "description": "Average star rating (computed)" },
        "avgRating": { "type": "number", "description": "Average star rating (computed)" },
        "reviewCount": { "type": "number", "description": "Number of reviews (computed)" },
        "totalReviews": { "type": "number", "description": "Number of reviews (computed)" },
        "description": { "type": "string", "description": "Short description of the spot" },
        "submitter": { "type": "string", "description": "Name of the person who submitted (optional)" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "photoUrl": { "type": "string", "description": "Optional photo URL" },
        "likes": { "type": "number" },
        "dislikes": { "type": "number" },
        "dishScore": { "type": "object", "description": "Map of dishId to fraction of reviewers who ate it" }
      },
      "required": ["name", "address", "dishes", "price", "location"]
    },
    "Review": {
      "title": "Review",
      "description": "A user review for a restaurant.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "submitter": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "photoUrl": { "type": "string" },
        "likes": { "type": "number" },
        "dislikes": { "type": "number" },
        "priceSpent": { "type": "number", "description": "Amount spent by the user" },
        "dishId": { "type": "string", "description": "ID of the dish the user ate" }
      },
      "required": ["rating", "comment", "submitter", "createdAt"]
    }
  },
  "firestore": {
    "restaurants": {
      "schema": "Restaurant",
      "description": "Collection of affordable restaurants."
    },
    "restaurants/{restaurantId}/reviews": {
      "schema": "Review",
      "description": "Subcollection of reviews for a specific restaurant."
    }
  }
}

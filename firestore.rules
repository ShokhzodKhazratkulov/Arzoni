rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: restaurants
    // Fields:
    //   - name: string (1-100 chars)
    //   - address: string (1-200 chars)
    //   - dishes: array of strings (1-20 items)
    //   - price: number (>= 0)
    //   - avgPrice: number
    //   - rating: number (0-5)
    //   - avgRating: number
    //   - reviewCount: number
    //   - totalReviews: number
    //   - description: string (< 500 chars)
    //   - submitter: string (< 100 chars)
    //   - location: map { lat: number, lng: number }
    //   - createdAt: string (ISO 8601)
    //   - photoUrl: string (optional, < 2000 chars)
    //   - likes: number
    //   - dislikes: number
    //   - dishScore: map
    //   - dishStats: map
    //   - dishPrices: map
    //
    // Collection: restaurants/{restaurantId}/reviews
    // Fields:
    //   - rating: number (1-5)
    //   - comment: string (1-1000 chars)
    //   - submitter: string (1-100 chars)
    //   - createdAt: string (ISO 8601)
    //   - restaurantId: string
    //   - photoUrl: string (optional)
    //   - likes: number
    //   - dislikes: number
    //   - priceSpent: number
    //   - dishId: string
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "abdullayevamuborak548@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidRestaurant(data) {
      return hasOnlyAllowedFields(['name', 'address', 'dishes', 'price', 'avgPrice', 'rating', 'avgRating', 'reviewCount', 'totalReviews', 'description', 'submitter', 'location', 'createdAt', 'photoUrl', 'likes', 'dislikes', 'dishScore', 'dishStats', 'dishPrices']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.address is string && data.address.size() > 0 && data.address.size() < 200 &&
             data.dishes is list && data.dishes.size() > 0 && data.dishes.size() < 20 &&
             data.price is number && data.price >= 0 &&
             data.rating is number && data.rating >= 0 && data.rating <= 5 &&
             data.reviewCount is number && data.reviewCount >= 0 &&
             data.description is string && data.description.size() < 500 &&
             data.submitter is string && data.submitter.size() < 100 &&
             data.location is map && data.location.lat is number && data.location.lng is number &&
             data.createdAt is string &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 2000)) &&
             (!('likes' in data) || data.likes is number) &&
             (!('dislikes' in data) || data.dislikes is number) &&
             (!('avgPrice' in data) || data.avgPrice is number) &&
             (!('avgRating' in data) || data.avgRating is number) &&
             (!('totalReviews' in data) || data.totalReviews is number) &&
             (!('dishScore' in data) || data.dishScore is map) &&
             (!('dishStats' in data) || data.dishStats is map) &&
             (!('dishPrices' in data) || data.dishPrices is map);
    }

    function isValidReview(data) {
      return hasOnlyAllowedFields(['rating', 'comment', 'submitter', 'createdAt', 'restaurantId', 'photoUrl', 'likes', 'dislikes', 'priceSpent', 'dishId']) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() < 1000 &&
             data.submitter is string && data.submitter.size() > 0 && data.submitter.size() < 100 &&
             data.createdAt is string &&
             data.restaurantId is string &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 2000)) &&
             (!('likes' in data) || data.likes is number) &&
             (!('dislikes' in data) || data.dislikes is number) &&
             (!('priceSpent' in data) || data.priceSpent is number) &&
             (!('dishId' in data) || data.dishId is string);
    }

    match /restaurants/{restaurantId} {
      // Public read access
      allow read: if true;
      
      // Public submissions
      allow create: if isValidRestaurant(request.resource.data);
      
      // Public updates (reviews update metrics)
      allow update: if isValidRestaurant(request.resource.data);
      
      // Public delete (for simplicity in unauthenticated mode)
      allow delete: if true; 

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isValidReview(request.resource.data);
        allow update: if isValidReview(request.resource.data);
        allow delete: if true;
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}

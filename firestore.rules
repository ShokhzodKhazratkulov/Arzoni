rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidRestaurant(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.address is string && data.address.size() > 0 &&
             data.dishes is list && data.dishes.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.rating is number && data.reviewCount is number &&
             data.description is string &&
             data.submitter is string &&
             data.location is map && 
             data.location.lat is number && data.location.lng is number &&
             data.createdAt is string &&
             (!('likes' in data) || data.likes is number) &&
             (!('dislikes' in data) || data.dislikes is number) &&
             (!('avgPrice' in data) || data.avgPrice is number) &&
             (!('avgRating' in data) || data.avgRating is number) &&
             (!('totalReviews' in data) || data.totalReviews is number) &&
             (!('dishScore' in data) || data.dishScore is map);
    }

    function isValidReview(data) {
      return data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 &&
             data.submitter is string && data.submitter.size() > 0 &&
             data.createdAt is string &&
             data.restaurantId is string &&
             (!('likes' in data) || data.likes is number) &&
             (!('dislikes' in data) || data.dislikes is number) &&
             (!('priceSpent' in data) || data.priceSpent is number) &&
             (!('dishId' in data) || data.dishId is string);
    }

    match /restaurants/{restaurantId} {
      // Allow anyone to read restaurants (public map)
      allow read: if true;
      
      // Allow anyone to create a restaurant (community submission)
      allow create: if isValidRestaurant(request.resource.data);
      
      // Allow updating rating, reviewCount, likes, and dislikes
      allow update: if true;
      
      allow delete: if false; 

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isValidReview(request.resource.data);
        allow update: if true;
        allow delete: if false;
      }
    }
  }
}
